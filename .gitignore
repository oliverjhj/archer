# ============================================
# ARCHER AI - GITIGNORE
# Minimal, focused rules for FastAPI + Docker on Windows
# ============================================

# Python Bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# Environment Variables (CRITICAL - Never commit secrets)
.env

# IDE Settings
.vscode/

# Windows System Files
Thumbs.db
desktop.ini

# Logs
*.log

# Database Files (SQLite - ALL databases excluded)
*.db
*.db-journal
*.db-wal
*.db-shm

# Backup Files
*.bak
*.backup

# Local Python virtual environments
.venv/

# Python tooling caches
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Build artifacts
dist/
build/
*.egg-info/

# UV package manager
.uv/

# Bob AI assistant workspace
.bob/
