# Frontend environment configuration (example).
# Copy to `.env.local` for local overrides. Never commit real `.env` files.
# This file must not contain secrets.
#
# Base URL for backend API calls.
# Leave empty to use same-origin relative paths (recommended).
# In local development the Vite dev proxy (see vite.config.ts) forwards API
# paths to the backend on http://localhost:8080, so this can stay empty.
VITE_API_BASE_URL=
