# ============================================
# ARCHER - ENVIRONMENT VARIABLES
# ============================================
#
# CRITICAL SECURITY WARNING:
# - NEVER commit the actual .env file to version control
# - This .env.example contains PLACEHOLDERS ONLY
# - Copy this file to .env and replace with your actual values
# - Ensure .env is listed in .gitignore
#
# PORTFOLIO/PUBLIC DEPLOYMENT WARNING:
# - Use ONLY synthetic/demo data for portfolio deployments
# - Do NOT use real customer/sales data in public demos
# - Verify all credentials are for non-production services
#
# SECRET KEY REQUIREMENTS:
# - JWT_SECRET_KEY must be at least 32 characters (SHA256 requirement)
# - CSRF_SECRET_KEY must be at least 32 characters (SHA256 requirement)
# - Use cryptographically secure random strings
# - Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
#

# --- Web Authentication ---
# Basic auth credentials for login page
WEB_USERNAME=your_username_here
WEB_PASSWORD=your_secure_password_here

# --- IBM Watsonx Configuration ---
# IBM Cloud API key for Watsonx.ai access
IBM_API_KEY=your_ibm_api_key_here

# IBM Watsonx project ID
PROJECT_ID=your_project_id_here

# --- Webhook Security ---
# Shared secret for the /ask webhook route. Server-side only:
# it must never reach browser code or any VITE_* variable.
WEBHOOK_SECRET=your_webhook_secret_here

# --- Token Signing Secrets ---
# MUST be at least 32 characters for SHA256 security
# Generate secure keys with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CSRF_SECRET_KEY=your_csrf_secret_key_minimum_32_characters_required_for_sha256
JWT_SECRET_KEY=your_jwt_secret_key_minimum_32_characters_required_for_sha256

# --- Demo cost ceiling ---
# Maximum questions answered per day, per process. IBM Cloud has no hard
# spending limit - its spending controls are notifications only - so this is
# the only thing that actually refuses. Set to 0 to disable (local development
# and the evaluation suite).
DEMO_DAILY_QUESTION_LIMIT=200

# --- Model ---
# Optional override, used by the evaluation suite to measure a different model.
# WATSONX_MODEL_ID=mistralai/mistral-small-3-1-24b-instruct-2503

# --- Dataset ---
# Filename of the SQLite database, resolved relative to the working directory.
# The database is generated into the image at build time by
# scripts/generate_dataset.py - it is not downloaded at runtime, so no object
# storage credentials are needed. Regenerate locally with:
#   python scripts/generate_dataset.py
DB_FILE_NAME=sales.db
