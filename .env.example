# Archer - environment variables
#
# Copy this file to .env and fill in your own values. .env is gitignored and
# must never be committed. In production the same variables live in a Code
# Engine secret (see infrastructure/README.md).
#
# Generate each secret key with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- Login ---
# The single account for the web interface. Login always fails if the username
# is empty.
WEB_USERNAME=your_username_here
WEB_PASSWORD=your_secure_password_here

# --- watsonx.ai ---
# An IBM Cloud API key with access to the watsonx.ai project, and the project ID.
IBM_API_KEY=your_ibm_api_key_here
PROJECT_ID=your_project_id_here

# Optional. The watsonx.ai endpoint for your region. Default: eu-gb.
# WATSONX_URL=https://eu-gb.ml.cloud.ibm.com

# Optional. The model for every step. Default: Mistral Small 3.1.
# WATSONX_MODEL_ID=mistralai/mistral-small-3-1-24b-instruct-2503

# Optional. A different model for one step: PLANNER, SQL, CHAT or SUMMARY.
# WATSONX_MODEL_ID_SQL=mistralai/mistral-small-3-1-24b-instruct-2503

# --- Machine callers ---
# The x-api-key for the /ask route. Server-side only: it must never reach
# browser code or any VITE_* variable.
WEBHOOK_SECRET=your_webhook_secret_here

# --- Signing keys ---
# At least 32 characters each.
CSRF_SECRET_KEY=your_csrf_secret_key_minimum_32_characters
JWT_SECRET_KEY=your_jwt_secret_key_minimum_32_characters

# --- Cost ceiling ---
# Messages answered per day, per process, reset at midnight UTC. IBM Cloud
# spending controls only send notifications, so this is what stops spending.
# Set to 0 to turn it off, for local development and evaluation runs.
DEMO_DAILY_QUESTION_LIMIT=200

# --- Features ---
# Optional. Set to 0 to turn off the corrected second attempt at a failed
# query, or the written summaries. Both are on by default.
# ARCHER_SQL_RETRY=0
# ARCHER_SUMMARIES=0

# --- Dataset ---
# The SQLite database, relative to the working directory. Build it with:
#   python scripts/generate_dataset.py
DB_FILE_NAME=sales.db
